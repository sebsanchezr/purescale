# PureScale — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel (Production + Preview).

# ---------- Site ----------
# Used to build Stripe success/cancel URLs. Set to the custom domain once live.
NEXT_PUBLIC_SITE_URL=https://purescale.co

# ---------- Stripe ----------
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_live_xxx
# Created when you add the webhook endpoint (see below). Starts whsec_
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional: use a saved Price instead of the inline $97 price_data
STRIPE_PRICE_ID=

# Webhook endpoint to create in Stripe:
#   URL:    https://<domain>/api/stripe-webhook
#   Event:  checkout.session.completed

# ---------- Meta ----------
# Pixel already live on the site
META_PIXEL_ID=1568881158178383
# Events Manager > Settings > Conversions API > Generate access token
META_CAPI_TOKEN=
# Set ONLY while testing (Events Manager > Test Events). Remove before launch —
# events sent with this code do not count toward optimisation.
META_TEST_EVENT_CODE=

# ---------- GoHighLevel ----------
# Private Integration token for the PureScale sub-account (Settings > Private Integrations)
GHL_API_KEY=
# The sub-account (location) id
GHL_LOCATION_ID=
# Optional — without these the pipeline card is skipped but tags/workflows still fire
GHL_PIPELINE_ID=
GHL_STAGE_NEW_ORDER_ID=
# Shared secret you also set on the GHL webhook action header `x-webhook-secret`
GHL_WEBHOOK_SECRET=
# Public URL of the GHL intake form — embedded on /ads/success
NEXT_PUBLIC_GHL_INTAKE_FORM_URL=

# ---------- Community ----------
# Discord invite for the members' community. Use a NON-expiring, unlimited-use invite
# (Discord defaults invites to expire in 7 days — a dead link in a paid receipt email
# is a support ticket every time).
NEXT_PUBLIC_COMMUNITY_INVITE_URL=

# ---------- Supabase (fulfilment queue) ----------
# Same project as the August OS. Service key — server-side only, never exposed.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
